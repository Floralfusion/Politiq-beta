# ── Clerk (Authentication — email/phone OTP) ────────────────────────────────
# Get these from https://dashboard.clerk.com after creating a POLITIQ app.
# Enable "Email code" and/or "Phone code (SMS OTP)" under User & Authentication > Email, Phone, Username.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEVER exposed to the client. Used only in Supabase Edge Functions / server context.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cashfree Payments ────────────────────────────────────────────────────
# Get these from https://merchant.cashfree.com (Developers > API Keys).
# Leave DEMO values in place to run the app in Demo Payment Mode (no real charges).
CASHFREE_APP_ID=DEMO_APP_ID
CASHFREE_SECRET_KEY=DEMO_SECRET_KEY
CASHFREE_ENV=TEST
# Toggles the client-visible payment mode banner. Set to "false" once real keys are added.
VITE_PAYMENTS_DEMO_MODE=true

# ── App ──────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
# Set to "true" to run entirely on local mock/demo data with no Supabase/Clerk network calls.
# Useful for previewing the UI before real keys are configured. The app also auto-falls-back
# to demo mode if Clerk/Supabase keys are missing.
VITE_DEMO_MODE=true
